{
    "manifest_version": 3,
    "name": "QualiFlow",
    "version": "3.0.2",
    "description": "Extensão para gerar e avaliar casos de teste BDD diretamente no Azure DevOps.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "tabs",
        "alarms"
    ],
    "host_permissions": [
        "*://dev.azure.com/*",
        "*://*.visualstudio.com/*",
        "*://*.atlassian.net/*",
        "<all_urls>"
    ],
    "background": {
        "service_worker": "src/entrypoints/background/index.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "*://dev.azure.com/*",
                "*://*.visualstudio.com/*",
                "*://*.atlassian.net/*"
            ],
            "css": [
                "src/styles/content.css"
            ],
            "js": [
                "src/presentation/content/main.js"
            ]
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "css": [
                "src/styles/content.css"
            ],
            "js": [
                "src/presentation/content/runner/main.js"
            ]
        }
    ],
    "options_page": "src/presentation/options/options.html",
    "action": {
        "default_title": "QualiFlow Configurações",
        "default_popup": "src/presentation/options/options.html"
    }
}