PORT=3000
FLASK_ENV=development

# OAuth GitHub (obrigatorio para login do QA)
GITHUB_OAUTH_CLIENT_ID=<seu-github-oauth-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<seu-github-oauth-client-secret>
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback
GITHUB_OAUTH_SCOPES=read:user user:email
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_STATE_SECRET=<gere-um-segredo-aleatorio>

# Sessao temporaria em memoria
AUTH_STATE_TTL_MS=600000
AUTH_SESSION_TTL_MS=28800000
AUTH_REQUEST_TTL_MS=900000

# OAuth Microsoft Entra ID (login Azure DevOps - substitui PAT)
AZURE_AD_CLIENT_ID=<seu-azure-ad-client-id>
AZURE_AD_CLIENT_SECRET=<seu-azure-ad-client-secret>
AZURE_AD_TENANT_ID=organizations
AZURE_AD_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# OAuth Atlassian 3LO (login Jira - substitui API Token)
ATLASSIAN_CLIENT_ID=<seu-atlassian-client-id>
ATLASSIAN_CLIENT_SECRET=<seu-atlassian-client-secret>
ATLASSIAN_REDIRECT_URI=http://localhost:3000/auth/atlassian/callback
ATLASSIAN_SCOPES=read:jira-work write:jira-work read:me offline_access

# Opcional: token de fallback server-to-server (evite usar em producao)
# COPILOT_GITHUB_TOKEN=<seu-token-github>

COPILOT_MODEL=gpt-5-mini
COPILOT_MODEL_FALLBACKS=claude-sonnet-4.5,claude-opus-4.5
COPILOT_REQUEST_TIMEOUT_MS=120000

# Controle de latencia/confiabilidade (Render free)
COPILOT_PER_MODEL_TIMEOUT_MS=60000
COPILOT_TOTAL_TIMEOUT_MS=120000
COPILOT_MAX_CONCURRENT_REQUESTS=2
COPILOT_QUEUE_WAIT_TIMEOUT_MS=120000

# Telemetria de runtime no log (RAM/CPU)
RUNTIME_METRICS_LOG_ENABLED=true
RUNTIME_METRICS_LOG_INTERVAL_MS=30000

# Chave opcional para proteger /metrics/report e /metrics/reset
# METRICS_ADMIN_KEY=<defina-uma-chave-forte>
