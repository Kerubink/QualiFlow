{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resultado do endpoint de debug /api/copilot/test",
  "description": "Formato retornado por build_qa_prompt. Usado tanto para ilustrar o prompt (via 'examples') quanto para validar a resposta do modelo.",
  "type": "object",
  "required": ["test_cases"],
  "properties": {
    "test_cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "titulo", "cenario", "dado", "quando", "entao", "prioridade"],
        "properties": {
          "id": { "type": "string" },
          "titulo": { "type": "string" },
          "cenario": { "type": "string" },
          "dado": { "type": "string" },
          "quando": { "type": "string" },
          "entao": { "type": "string" },
          "prioridade": { "type": "string", "enum": ["Alta", "Media", "Baixa"] }
        }
      }
    }
  },
  "examples": [
    {
      "test_cases": [
        {
          "id": "CT-001",
          "titulo": "string",
          "cenario": "string",
          "dado": "string",
          "quando": "string",
          "entao": "string",
          "prioridade": "Alta"
        },
        {
          "id": "CT-002",
          "titulo": "string",
          "cenario": "string",
          "dado": "string",
          "quando": "string",
          "entao": "string",
          "prioridade": "Media"
        }
      ]
    }
  ]
}
